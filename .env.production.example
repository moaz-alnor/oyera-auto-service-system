# Public address
OYERA_DOMAIN=oyera.example.com
OYERA_HTTP_PORT=80
OYERA_HTTPS_PORT=443

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=oyera.example.com
DJANGO_HEALTHCHECK_HOST=oyera.example.com
DJANGO_LOG_LEVEL=INFO
DJANGO_TRUST_X_FORWARDED_PROTO=true

# Keep HSTS disabled until production HTTPS is verified.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# PostgreSQL administrator
POSTGRES_ADMIN_USER=oyera_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Restricted OYERA application account
POSTGRES_DB=oyera_service
POSTGRES_USER=oyera_app
POSTGRES_PASSWORD=replace-with-a-different-strong-app-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info

# Startup operations
OYERA_RUN_MIGRATIONS=true
OYERA_COLLECT_STATIC=true
